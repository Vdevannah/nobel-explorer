     "argument_constraints": [{"tool": "search_laureates", "arg": "year", "equals": 2022}, {"tool": "search_laureates", "arg": "category", "equals": "Chemistry"}],
     "must_include_any": [["Bertozzi"], ["Sharpless"], ["Meldal"]],
     "grounding_facts": ["Bertozzi", "Sharpless", "Meldal"],
     "citations": {"min_valid": 1, "required_statuses": ["structured_record"]},
     "fake_plan": [[{"tool": "search_laureates", "args": {"year": 2022, "category": "Chemistry"}}]]},
