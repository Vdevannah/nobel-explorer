{
  "description": "Phase 2 tool evaluation. Each case lists the tool call(s) a correct agent SHOULD make, with deterministic arguments, and checks on the results. Expected values were derived from the live database with independent raw SQL before the tools were run. The runner invokes the expected tools directly (scripted); this measures tool correctness, NOT autonomous LLM tool selection (Phase 3).",
  "version": 1,
  "created": "2026-11-26",
  "cases": [
    {"id": "T01", "group": "exact_structured", "question": "Who won the 2022 Nobel Prize in Chemistry?",
     "steps": [{"tool": "search_laureates", "args": {"year": 2022, "category": "Chemistry"},
                "expect": [{"path": "data.laureates.*.full_name", "equals": ["Carolyn R. Bertozzi", "K. Barry Sharpless", "Morten Meldal"]},
                           {"path": "data.total_matches", "equals": 3}]}]},
    {"id": "T02", "group": "exact_structured", "question": "Who won the 2023 Nobel Prize in Physiology or Medicine?",
     "steps": [{"tool": "search_laureates", "args": {"year": 2023, "category": "Medicine"},
                "expect": [{"path": "data.laureates.*.full_name", "equals": ["Drew Weissman", "Katalin Karikó"]}]}]},
    {"id": "T03", "group": "exact_structured", "question": "Who received the 2017 Nobel Prize in Physics?",
     "steps": [{"tool": "search_laureates", "args": {"year": 2017, "category": "Physics"},
                "expect": [{"path": "data.laureates.*.full_name", "equals": ["Barry C. Barish", "Kip S. Thorne", "Rainer Weiss"]}]}]},
    {"id": "T04", "group": "exact_structured", "question": "Which women have won the Nobel Prize in Physics?",
     "steps": [{"tool": "search_laureates", "args": {"category": "Physics", "gender": "female"},
                "expect": [{"path": "data.laureates.*.full_name", "equals": ["Andrea Ghez", "Anne L’Huillier", "Donna Strickland", "Maria Goeppert Mayer", "Marie Curie, née Skłodowska"]}]}]},
    {"id": "T05", "group": "exact_structured", "question": "Who won the 1921 Nobel Prize in Physics?",
     "steps": [{"tool": "search_laureates", "args": {"year": 1921, "category": "Physics"},
                "expect": [{"path": "data.laureates.*.laureate_id", "equals": [249]},
                           {"path": "data.laureates.0.matched_awards.0.motivation", "contains": "photoelectric effect"}]}]},
    {"id": "T06", "group": "exact_structured", "question": "Which Danish-born laureates won the Nobel Prize in Chemistry?",
     "steps": [{"tool": "search_laureates", "args": {"category": "Chemistry", "birth_country": "Denmark"},
                "expect": [{"path": "data.laureates.*.full_name", "equals": ["Jens C. Skou", "Morten Meldal"]}]}]},
    {"id": "T07", "group": "laureate_details", "question": "Why did Albert Einstein receive the Nobel Prize?",
     "steps": [{"tool": "search_laureates", "args": {"name": "Einstein"},
                "expect": [{"path": "data.laureates.*.laureate_id", "equals": [249]}]},
               {"tool": "get_laureate_details", "args": {"laureate_id": {"$ref": 0, "path": "data.laureates.0.laureate_id"}},
                "expect": [{"path": "data.awards.0.year", "equals": 1921},
                           {"path": "data.awards.0.motivation", "contains": "law of the photoelectric effect"},
                           {"path": "data.contributions.*.title", "equals": ["Photoelectric Effect", "General Relativity"]}]}]},
    {"id": "T08", "group": "laureate_details", "question": "What educational content exists about Katalin Karikó's work?",
     "steps": [{"tool": "get_laureate_details", "args": {"laureate_id": 774},
                "expect": [{"path": "data.contributions.*.title", "equals": ["Nucleoside Base Modifications and mRNA Vaccines"]},
                           {"path": "data.contributions.0.explanation_levels_available", "equals": ["Simple", "Explore", "Advanced", "Expert"]},
                           {"path": "data.contributions.0.citation_status", "equals": "source_linked"}]}]},
    {"id": "T09", "group": "laureate_details", "question": "Tell me about Wilhelm Röntgen's educational content.",
     "steps": [{"tool": "get_laureate_details", "args": {"laureate_id": 1199},
                "expect": [{"path": "data.laureate.full_name", "equals": "Wilhelm Conrad Röntgen"},
                           {"path": "data.educational_content_available", "equals": false},
                           {"path": "data.message", "contains": "only structured prize data"}]}]},
    {"id": "T10", "group": "statistics", "question": "How many laureates, prizes and awards are in the database?",
     "steps": [{"tool": "get_nobel_statistics", "args": {"operation": "summary"},
                "expect": [{"path": "data.result.distinct_laureates", "equals": 1018},
                           {"path": "data.result.laureate_prize_awards", "equals": 1026},
                           {"path": "data.result.prizes", "equals": 633}]}]},
    {"id": "T11", "group": "statistics", "question": "How many different people and organizations have won the Chemistry prize?",
     "steps": [{"tool": "get_nobel_statistics", "args": {"operation": "laureates_by_category"},
                "expect": [{"path": "data.result.[category=Chemistry].laureate_count", "equals": 198}]}]},
    {"id": "T12", "group": "statistics", "question": "How many women have won a Nobel Prize?",
     "steps": [{"tool": "get_nobel_statistics", "args": {"operation": "laureates_by_gender"},
                "expect": [{"path": "data.result.[gender=female].laureate_count", "equals": 67}]}]},
    {"id": "T13", "group": "statistics", "question": "Which birth countries have produced the most laureates?",
     "steps": [{"tool": "get_nobel_statistics", "args": {"operation": "top_birth_countries", "limit": 3},
                "expect": [{"path": "data.result", "equals": [{"birth_country": "USA", "laureate_count": 296}, {"birth_country": "United Kingdom", "laureate_count": 94}, {"birth_country": "Germany", "laureate_count": 80}]}]}]},
    {"id": "T14", "group": "statistics", "question": "What is the average age of Physics laureates when they won?",
     "steps": [{"tool": "get_nobel_statistics", "args": {"operation": "average_age_at_award", "category": "Physics"},
                "expect": [{"path": "data.result.average_age_at_award", "equals": 57.5}]}]},
    {"id": "T15", "group": "statistics", "question": "Which US institutions were home to the most Chemistry laureates at award time?",
     "steps": [{"tool": "get_nobel_statistics", "args": {"operation": "laureates_by_affiliation_institution", "category": "Chemistry", "affiliation_country": "USA", "limit": 3},
                "expect": [{"path": "data.result", "equals": [{"institution": "University of California", "laureate_count": 15}, {"institution": "Howard Hughes Medical Institute", "laureate_count": 8}, {"institution": "Harvard University", "laureate_count": 6}]}]}]},
    {"id": "T16", "group": "semantic", "question": "Explain the photoelectric effect in simple terms.",
     "steps": [{"tool": "search_nobel_knowledge", "args": {"query": "Explain the photoelectric effect in simple terms", "level": "Simple"},
                "expect": [{"path": "data.results.0.doc_id", "equals": "explanation:38:simple"},
                           {"path": "data.results.0.citation_status", "equals": "unverified_educational"}]}]},
    {"id": "T17", "group": "semantic", "question": "How does GPS depend on Einstein's relativity?",
     "steps": [{"tool": "search_nobel_knowledge", "args": {"query": "How does GPS depend on Einstein's theory of relativity?"},
                "expect": [{"path": "data.results.*.doc_id", "any_in_first": {"k": 3, "values": ["connection:27"]}}]}]},
    {"id": "T18", "group": "semantic", "question": "Why does chemically modified mRNA avoid triggering the immune system?",
     "steps": [{"tool": "search_nobel_knowledge", "args": {"query": "Why does chemically modified mRNA avoid triggering the immune system?"},
                "expect": [{"path": "data.results.*.doc_id", "any_in_first": {"k": 3, "values": ["contribution:609", "explanation:609:simple", "explanation:609:explore", "explanation:609:advanced", "explanation:609:expert", "connection:278"]}}]}]},
    {"id": "T19", "group": "semantic", "question": "How is click chemistry used in cancer research?",
     "steps": [{"tool": "search_nobel_knowledge", "args": {"query": "How is click chemistry used in cancer research?"},
                "expect": [{"path": "data.results.*.doc_id", "any_in_first": {"k": 3, "values": ["connection:344"]}},
                           {"path": "data.results.0.weak_match", "equals": false}]}]},
    {"id": "T20", "group": "multi_step", "question": "What did the 2023 Medicine laureates discover, explained simply?",
     "steps": [{"tool": "search_laureates", "args": {"year": 2023, "category": "Physiology or Medicine"},
                "expect": [{"path": "data.total_matches", "equals": 2}]},
               {"tool": "search_nobel_knowledge", "args": {"query": "nucleoside modification of mRNA", "level": "Simple",
                                                           "laureate_id": {"$ref": 0, "path": "data.laureates.[full_name=Katalin Karikó].laureate_id"}},
                "expect": [{"path": "data.results.0.doc_id", "equals": "explanation:609:simple"},
                           {"path": "data.filters.laureate_id", "equals": 774}]}]},
    {"id": "T21", "group": "multi_step", "question": "What is the gravitational-wave legacy of general relativity, and who won the prize for detecting the waves?",
     "steps": [{"tool": "search_nobel_knowledge", "args": {"query": "gravitational waves legacy of general relativity"},
                "expect": [{"path": "data.results.*.doc_id", "any_in_first": {"k": 3, "values": ["connection:29"]}}]},
               {"tool": "search_laureates", "args": {"year": 2017, "category": "Physics"},
                "expect": [{"path": "data.laureates.*.full_name", "equals": ["Barry C. Barish", "Kip S. Thorne", "Rainer Weiss"]}]}]},
    {"id": "T22", "group": "multi_step", "question": "Who shared the 2022 Chemistry prize, and how is their work explained at the Explore level?",
     "steps": [{"tool": "search_laureates", "args": {"year": 2022, "category": "Chemistry"},
                "expect": [{"path": "data.total_matches", "equals": 3}]},
               {"tool": "get_laureate_details", "args": {"laureate_id": {"$ref": 0, "path": "data.laureates.[full_name=Carolyn R. Bertozzi].laureate_id"}, "include_explanation_level": "Explore"},
                "expect": [{"path": "data.contributions.0.explanation.level", "equals": "Explore"},
                           {"path": "data.contributions.0.explanation.citation_status", "equals": "unverified_educational"}]}]},
    {"id": "T23", "group": "ambiguous", "question": "Tell me about Curie.",
     "steps": [{"tool": "search_laureates", "args": {"name": "Curie"},
                "expect": [{"path": "data.ambiguous_name", "equals": true},
                           {"path": "data.laureates.*.full_name", "equals": ["Irène Joliot-Curie", "Marie Curie, née Skłodowska", "Pierre Curie"]}]}]},
    {"id": "T24", "group": "ambiguous", "question": "What did Bohr win the Nobel Prize for?",
     "steps": [{"tool": "search_laureates", "args": {"name": "Bohr"},
                "expect": [{"path": "data.ambiguous_name", "equals": true},
                           {"path": "data.laureates.*.full_name", "equals": ["Aage Niels Bohr", "Niels Henrik David Bohr"]}]}]},
    {"id": "T25", "group": "false_premise", "question": "Who won the Nobel Prize in Mathematics in 1950?",
     "steps": [{"tool": "search_laureates", "args": {"category": "Mathematics", "year": 1950},
                "expect": [{"path": "ok", "equals": false}, {"path": "error.type", "equals": "validation_error"},
                           {"path": "error.message", "contains": "There is no Nobel Prize in Mathematics"}]},
               {"tool": "search_nobel_knowledge", "args": {"query": "Who won the Nobel Prize in Mathematics in 1950?"},
                "expect": [{"path": "data.results.0.weak_match", "equals": false}],
                "note": "Documents a limitation: semantic search scores this false premise as a strong match."}]},
    {"id": "T26", "group": "false_premise", "question": "Who won the Nobel Prize in Economics in 1950?",
     "steps": [{"tool": "search_laureates", "args": {"category": "Economics", "year": 1950},
                "expect": [{"path": "data.total_matches", "equals": 0},
                           {"path": "data.coverage.category_first_year", "equals": 1969},
                           {"path": "data.message", "contains": "Economic Sciences prizes in the database run from 1969"}]}]},
    {"id": "T27", "group": "unsupported_category", "question": "Give me statistics for the Nobel Prize in Computer Science.",
     "steps": [{"tool": "get_nobel_statistics", "args": {"operation": "summary", "category": "Computer Science"},
                "expect": [{"path": "ok", "equals": false}, {"path": "error.message", "contains": "not a Nobel Prize category"}]}]},
    {"id": "T28", "group": "out_of_scope", "question": "What is a good recipe for sourdough bread?",
     "steps": [{"tool": "search_nobel_knowledge", "args": {"query": "What is a good recipe for sourdough bread?"},
                "expect": [{"path": "data.all_results_weak", "equals": true}]}]},
    {"id": "T29", "group": "out_of_scope", "question": "Who won the 2022 FIFA World Cup?",
     "steps": [{"tool": "search_nobel_knowledge", "args": {"query": "Who won the 2022 FIFA World Cup?"},
                "expect": [{"path": "data.all_results_weak", "equals": true}]}]},
    {"id": "T30", "group": "out_of_scope", "question": "Who won the 2030 Nobel Prize in Physics?",
     "steps": [{"tool": "search_laureates", "args": {"year": 2030, "category": "Physics"},
                "expect": [{"path": "ok", "equals": false}, {"path": "error.message", "contains": "year"}]}]}
  ]
}
