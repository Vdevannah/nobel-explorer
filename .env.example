DB_HOST=localhost
DB_PORT=3306
DB_NAME=nobel_explorer
DB_USER=
DB_PASSWORD=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI research assistant (optional; disabled by default). Put the real key only in
# your git-ignored .env (chmod 600). Never commit it.
AI_AGENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Paid evaluation gate for backend.ai.evaluation.run_agent_eval --mode openai
AI_ALLOW_PAID_EVAL=0

# Nobel Intelligence production safeguards (defaults shown; all optional).
# Counters are kept in memory: they reset on restart/redeploy and are per replica.
# AI_RATE_PER_IP_PER_MINUTE=5
# AI_RATE_PER_IP_PER_DAY=50
# AI_GLOBAL_DAILY_LIMIT=100
# AI_MAX_CONCURRENT_REQUESTS=2
# AI_MAX_BODY_BYTES=16384
# Client-address header; leave empty locally. On Railway use x-real-ip.
# AI_CLIENT_IP_HEADER=
# Application-level spending guard (USD, conservative estimates).
# AI_DAILY_SPEND_LIMIT_USD=0.05
# AI_MONTHLY_SPEND_LIMIT_USD=0.90
# Load the embedding model at startup when the assistant is enabled.
# AI_WARMUP=true
